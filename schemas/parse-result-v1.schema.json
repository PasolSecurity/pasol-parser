{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pasolsecurity.org/schemas/parse-result-v1.schema.json",
  "title": "Pasol parse result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "parser", "parser_version", "file_type", "sha256", "size", "status", "metadata", "warnings"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "parser": { "type": "string", "minLength": 1 },
    "parser_version": { "type": "string", "minLength": 1 },
    "file_type": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "size": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["complete", "partial"] },
    "metadata": {},
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    }
  },
  "$defs": {
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "offset": { "type": "string", "pattern": "^0x[0-9a-f]+$" }
      }
    }
  }
}
